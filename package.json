{
  "name": "repotrace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787",
    "build": "tsc --noEmit && vite build",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "npm run build && npm test && wrangler deploy --dry-run"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.0",
    "wrangler": "4.156.0"
  }
}
