{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repotrace",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [{ "binding": "DB", "database_name": "repotrace-db" }],
  "kv_namespaces": [{ "binding": "WEBHOOK_KEYS" }],
  "durable_objects": {
    "bindings": [{ "name": "RELEASE_SCHEDULER", "class_name": "ReleaseScheduler" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReleaseScheduler"] }],
  "triggers": { "crons": ["* * * * *"] },
  "build": { "command": "npm run build" },
  "observability": { "enabled": true },
}
